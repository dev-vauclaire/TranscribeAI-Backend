# Copiez ce fichier vers .env uniquement pour un environnement local.
# Utilisez des secrets gérés par l'orchestrateur hors développement.
POSTGRES_DB=transcribe_ai
POSTGRES_USER=transcribe_ai
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://transcribe_ai:replace-with-a-local-password@postgres:5432/transcribe_ai
REDIS_URL=redis://redis:6379/0

API_PUBLISHED_PORT=8000
POSTGRES_PUBLISHED_PORT=5432
REDIS_PUBLISHED_PORT=6379

WORKER_FAST_ID=worker-fast-local
WORKER_LONG_FORM_DIARIZATION_ID=worker-long-form-diarization-local

# Requis uniquement avec docker-compose.cpu.yml ou docker-compose.gpu.yml.
# WORKER_TRANSCRIBER_HUGGING_FACE_TOKEN=hf_replace_me
