DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379/0
WORKER_ID=worker-long-form-diarization-local
WORKER_CONSUMER_GROUP=transcription-workers
WORKER_BLOCK_MILLISECONDS=5000
WORKER_AUTOCLAIM_INTERVAL_SECONDS=60
WORKER_AUTOCLAIM_MIN_IDLE_MILLISECONDS=300000
WORKER_LEASE_SECONDS=300
WORKER_HEARTBEAT_SECONDS=60
# Nombre total d'exécutions autorisées, tentative initiale incluse.
MAX_ATTEMPTS=3
WORKER_ENVIRONMENT=development
WORKER_TRANSCRIBER_BACKEND=fake
WORKER_TRANSCRIBER_MODEL=large-v3-turbo
WORKER_TRANSCRIBER_DEVICE=cpu
WORKER_TRANSCRIBER_COMPUTE_TYPE=default
WORKER_TRANSCRIBER_BATCH_SIZE=16
# Requis avec WORKER_TRANSCRIBER_BACKEND=whisperx. Ne commitez jamais sa valeur.
WORKER_TRANSCRIBER_HUGGING_FACE_TOKEN=
WORKER_TRANSCRIBER_MODEL_DIRECTORY=/models
WORKER_TRANSCRIBER_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
AUDIO_STORAGE_PATH=/data/transcriptions
