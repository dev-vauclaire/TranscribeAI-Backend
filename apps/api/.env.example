# PostgreSQL reste la source de vérité des jobs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_ECHO=false
DATABASE_POOL_SIZE=4
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT_SECONDS=30

# Volume partagé avec les workers et l'application maintenance.
AUDIO_STORAGE_PATH=/data/transcriptions

# 100 MiB. La valeur est exprimée en octets et doit être strictement positive.
API_MAX_UPLOAD_SIZE_BYTES=104857600

# Binaire utilisé pour inspecter les conteneurs et flux audio.
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_SECONDS=30

# Délai maximal accordé au contrôle PostgreSQL de readiness.
API_READINESS_TIMEOUT_SECONDS=2

# Règles métier de durée, exprimées en secondes (15 min / 4 h).
API_FAST_MAX_DURATION_SECONDS=900
API_LONG_FORM_DIARIZATION_MAX_DURATION_SECONDS=14400

# Serveur ASGI.
API_HOST=0.0.0.0
API_PORT=8000
